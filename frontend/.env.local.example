NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public site origin (no trailing slash) — used to build absolute canonical/OG URLs
# and the URLs in sitemap.xml. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The admin panel shares the same apiClient/base URL above (adminApi just adds an
# /admin path prefix) and the same HttpOnly-cookie JWT auth as the rest of the app —
# no separate admin API URL. Set to "true" to fall back to the MSW mock layer
# (src/mocks/admin/) instead of the real backend, e.g. for offline UI work.
NEXT_PUBLIC_ADMIN_USE_MOCKS=false

# "Sign in with Google" / Facebook Login — must match GOOGLE_CLIENT_ID / FACEBOOK_APP_ID
# in the backend's .env exactly. Safe to expose publicly (client IDs, not secrets).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
