# ──────────────────────────────────────────────────────────────────────────────
# E2E Security Test Configuration
# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# Backend base URL (no trailing slash)
API_BASE_URL=http://localhost:8000

# ── Admin account (must have admin.manage permission or role=super_admin) ──────
TEST_ADMIN_EMAIL=admin@yoursalon.com
TEST_ADMIN_PASSWORD=your_admin_password_here

# ── Regular salon user (must NOT be super_admin — used for privilege tests) ───
# Can be a salon_owner, manager, receptionist, or staff member
TEST_USER_EMAIL=owner@salon-a.com
TEST_USER_PASSWORD=your_user_password_here

# ── Second salon user (needed for tenant isolation tests 06) ──────────────────
# Must belong to a DIFFERENT salon than TEST_USER_EMAIL
TEST_SALON_B_EMAIL=owner@salon-b.com
TEST_SALON_B_PASSWORD=your_salon_b_password_here
