
USE salon_saas;

-- ============================================
-- SALONS
-- ============================================

CREATE TABLE salons (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    name VARCHAR(255) NOT NULL,
    slug VARCHAR(191) UNIQUE NOT NULL,

    email VARCHAR(255),
    phone VARCHAR(50),

    address TEXT,

    logo VARCHAR(500),

    timezone VARCHAR(100) DEFAULT 'Asia/Colombo',
    currency VARCHAR(20) DEFAULT 'LKR',
    require_payment_upfront BOOLEAN DEFAULT FALSE,

    subscription_status ENUM(
        'trial',
        'active',
        'expired',
        'cancelled'
    ) DEFAULT 'trial',

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP
);

-- ============================================
-- USERS
-- ============================================

CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NULL,

    name VARCHAR(255) NOT NULL,

    email VARCHAR(191) UNIQUE,
    phone VARCHAR(50),

    password VARCHAR(255) NOT NULL,

    role ENUM(
        'super_admin',
        'salon_owner',
        'manager',
        'receptionist',
        'staff',
        'customer'
    ) DEFAULT 'staff',

    profile_image VARCHAR(500),

    last_login_at TIMESTAMP NULL,

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_users_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- PERMISSIONS
-- ============================================

CREATE TABLE permissions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    module VARCHAR(100) NOT NULL,

    permission_key VARCHAR(100) UNIQUE NOT NULL,

    description VARCHAR(255),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- USER PERMISSIONS
-- Direct User Permission Assignment
-- ============================================

CREATE TABLE user_permissions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    user_id BIGINT NOT NULL,

    permission_id BIGINT NOT NULL,

    allowed BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    UNIQUE KEY unique_user_permission (
        user_id,
        permission_id
    ),

    CONSTRAINT fk_user_permissions_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_user_permissions_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_user_permissions_permission
        FOREIGN KEY (permission_id)
        REFERENCES permissions(id)
        ON DELETE CASCADE
);

-- ============================================
-- BRANCHES
-- ============================================

CREATE TABLE branches (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    name VARCHAR(255) NOT NULL,

    phone VARCHAR(50),

    address TEXT,

    opening_time TIME,
    closing_time TIME,

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_branches_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- STAFF
-- ============================================

CREATE TABLE staff (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    branch_id BIGINT,

    user_id BIGINT NOT NULL,

    designation VARCHAR(255),

    salary DECIMAL(10,2) DEFAULT 0,

    commission_type ENUM(
        'fixed',
        'percentage'
    ) DEFAULT 'percentage',

    commission_value DECIMAL(10,2) DEFAULT 0,

    joining_date DATE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_staff_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_staff_branch
        FOREIGN KEY (branch_id)
        REFERENCES branches(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_staff_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
);

-- ============================================
-- CUSTOMERS
-- ============================================

CREATE TABLE customers (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    name VARCHAR(255) NOT NULL,

    phone VARCHAR(50),
    email VARCHAR(255),

    gender ENUM(
        'male',
        'female',
        'other'
    ),

    dob DATE,

    loyalty_points INT DEFAULT 0,

    notes TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_customers_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- SERVICE CATEGORIES
-- ============================================

CREATE TABLE service_categories (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    name VARCHAR(255) NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_service_categories_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- SERVICES
-- ============================================

CREATE TABLE services (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    category_id BIGINT,

    name VARCHAR(255) NOT NULL,

    duration_minutes INT DEFAULT 30,

    price DECIMAL(10,2) NOT NULL,

    description TEXT,

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_services_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_services_category
        FOREIGN KEY (category_id)
        REFERENCES service_categories(id)
        ON DELETE SET NULL
);

-- ============================================
-- APPOINTMENTS
-- ============================================

CREATE TABLE appointments (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    branch_id BIGINT,

    customer_id BIGINT NOT NULL,

    staff_id BIGINT,

    appointment_date DATE NOT NULL,

    start_time TIME NOT NULL,
    end_time TIME NOT NULL,

    status ENUM(
        'pending',
        'confirmed',
        'in_progress',
        'started',
        'completed',
        'cancelled',
        'no_show'
    ) DEFAULT 'pending',

    total_amount DECIMAL(10,2) DEFAULT 0,

    notes TEXT,

    created_by BIGINT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_appointments_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_appointments_branch
        FOREIGN KEY (branch_id)
        REFERENCES branches(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_appointments_customer
        FOREIGN KEY (customer_id)
        REFERENCES customers(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_appointments_staff
        FOREIGN KEY (staff_id)
        REFERENCES staff(id)
        ON DELETE SET NULL
);

-- ============================================
-- APPOINTMENT SERVICES
-- ============================================

CREATE TABLE appointment_services (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    appointment_id BIGINT NOT NULL,

    service_id BIGINT NOT NULL,

    price DECIMAL(10,2) NOT NULL,

    duration_minutes INT NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_appointment_services_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointments(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_appointment_services_service
        FOREIGN KEY (service_id)
        REFERENCES services(id)
        ON DELETE CASCADE
);

-- ============================================
-- INVOICES
-- ============================================

CREATE TABLE invoices (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    appointment_id BIGINT,

    customer_id BIGINT NOT NULL,

    invoice_number VARCHAR(100) UNIQUE,

    subtotal DECIMAL(10,2) DEFAULT 0,
    discount DECIMAL(10,2) DEFAULT 0,
    tax DECIMAL(10,2) DEFAULT 0,
    total DECIMAL(10,2) DEFAULT 0,

    payment_status ENUM(
        'pending',
        'partial',
        'paid'
    ) DEFAULT 'pending',

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_invoices_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_invoices_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointments(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_invoices_customer
        FOREIGN KEY (customer_id)
        REFERENCES customers(id)
        ON DELETE CASCADE
);

-- ============================================
-- INVOICE ITEMS
-- ============================================

CREATE TABLE invoice_items (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    invoice_id BIGINT NOT NULL,

    service_id BIGINT,
    product_id BIGINT,

    item_name VARCHAR(255) NOT NULL,
    quantity INT DEFAULT 1,
    unit_price DECIMAL(10,2) NOT NULL,
    total_price DECIMAL(10,2) NOT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_items_invoice
        FOREIGN KEY (invoice_id)
        REFERENCES invoices(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_items_service
        FOREIGN KEY (service_id)
        REFERENCES services(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_items_product
        FOREIGN KEY (product_id)
        REFERENCES products(id)
        ON DELETE SET NULL
);

-- ============================================
-- PAYMENTS
-- ============================================

CREATE TABLE payments (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    invoice_id BIGINT NOT NULL,

    payment_method ENUM(
        'cash',
        'card',
        'bank_transfer',
        'qr'
    ),

    amount DECIMAL(10,2) NOT NULL,

    transaction_reference VARCHAR(255),

    paid_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_payments_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_payments_invoice
        FOREIGN KEY (invoice_id)
        REFERENCES invoices(id)
        ON DELETE CASCADE
);

-- ============================================
-- PRODUCTS
-- ============================================

CREATE TABLE products (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    name VARCHAR(255) NOT NULL,

    sku VARCHAR(100),

    barcode VARCHAR(100),

    cost_price DECIMAL(10,2) DEFAULT 0,
    selling_price DECIMAL(10,2) DEFAULT 0,

    stock_quantity INT DEFAULT 0,

    low_stock_alert INT DEFAULT 5,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_products_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- INVENTORY TRANSACTIONS
-- ============================================

CREATE TABLE inventory_transactions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    product_id BIGINT NOT NULL,

    type ENUM(
        'purchase',
        'sale',
        'usage',
        'adjustment'
    ),

    quantity INT NOT NULL,

    notes TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_inventory_transactions_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_inventory_transactions_product
        FOREIGN KEY (product_id)
        REFERENCES products(id)
        ON DELETE CASCADE
);

-- ============================================
-- LOYALTY TRANSACTIONS
-- ============================================

CREATE TABLE loyalty_transactions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    customer_id BIGINT NOT NULL,

    points INT NOT NULL,

    type ENUM(
        'earned',
        'redeemed'
    ),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_loyalty_transactions_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_loyalty_transactions_customer
        FOREIGN KEY (customer_id)
        REFERENCES customers(id)
        ON DELETE CASCADE
);

-- ============================================
-- SUBSCRIPTIONS
-- ============================================

CREATE TABLE subscriptions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    plan_name VARCHAR(255),

    amount DECIMAL(10,2),

    starts_at DATE,
    expires_at DATE,

    status ENUM(
        'active',
        'expired',
        'cancelled'
    ) DEFAULT 'active',

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_subscriptions_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- NOTIFICATIONS
-- ============================================

CREATE TABLE notifications (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    user_id BIGINT NOT NULL,

    type VARCHAR(100),

    title VARCHAR(255),

    message TEXT,

    is_read BOOLEAN DEFAULT FALSE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_notifications_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_notifications_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
);

-- ============================================
-- SETTINGS
-- ============================================

CREATE TABLE settings (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT NOT NULL,

    setting_key VARCHAR(191),

    setting_value TEXT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    UNIQUE KEY unique_salon_setting (
        salon_id,
        setting_key
    ),

    CONSTRAINT fk_settings_salon
        FOREIGN KEY (salon_id)
        REFERENCES salons(id)
        ON DELETE CASCADE
);

-- ============================================
-- AUDIT LOGS
-- ============================================

CREATE TABLE audit_logs (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,

    salon_id BIGINT,

    user_id BIGINT,

    action VARCHAR(255),

    table_name VARCHAR(255),

    record_id BIGINT,

    old_values JSON,
    new_values JSON,

    ip_address VARCHAR(100),

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- INDEXES
-- ============================================

CREATE INDEX idx_users_salon
ON users(salon_id);

CREATE INDEX idx_customers_salon
ON customers(salon_id);

CREATE INDEX idx_services_salon
ON services(salon_id);

CREATE INDEX idx_appointments_salon
ON appointments(salon_id);

CREATE INDEX idx_appointments_customer
ON appointments(customer_id);

CREATE INDEX idx_appointments_staff
ON appointments(staff_id);

CREATE INDEX idx_appointments_date
ON appointments(appointment_date);

CREATE INDEX idx_invoices_salon
ON invoices(salon_id);

CREATE INDEX idx_products_salon
ON products(salon_id);

CREATE INDEX idx_notifications_user
ON notifications(user_id);

-- ============================================
-- BUSINESS HOURS
-- ============================================

CREATE TABLE salon_business_hours (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    salon_id BIGINT NOT NULL,
    day_of_week TINYINT NOT NULL COMMENT '0=Sunday, 1=Monday, ..., 6=Saturday',
    is_open BOOLEAN DEFAULT TRUE,
    open_time TIME DEFAULT '08:00:00',
    close_time TIME DEFAULT '18:00:00',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE KEY unique_salon_day (salon_id, day_of_week),
    CONSTRAINT fk_business_hours_salon FOREIGN KEY (salon_id) REFERENCES salons(id) ON DELETE CASCADE
);

CREATE INDEX idx_business_hours_salon ON salon_business_hours(salon_id);

