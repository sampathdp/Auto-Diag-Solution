				{
					"name": "Create Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"// json.orderId is the base id (e.g. \"100765\") — this is what both",
									"// GET /orders/{id} and PUT /orders/{id} accept. json.displayId does not",
									"// exist on this response; the old displayId+'-'+orderPartSeqId composite",
									"// was always \"undefined-01\" and broke chained requests.",
									"if (json && json.orderId) {",
									"    pm.collectionVariables.set('orderId', json.orderId);",
									"}",
									"pm.test('returns 200', () => pm.response.to.have.status(200));",
									"pm.test('orderId present', () => pm.expect(json.orderId).to.be.a('string').and.not.empty);",
									"pm.test('customerPartyId resolved', () => pm.expect(json.customerPartyId).to.be.a('string').and.not.empty);"
